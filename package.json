{
  "name": "ffui",
  "private": true,
  "version": "0.3.6",
  "packageManager": "pnpm@10.26.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "version:set": "node scripts/set-version.mjs",
    "check:all": "node scripts/check-all-coalesce.mjs",
    "check:queue-contracts": "cargo test generated_queue_ipc_contracts_match_committed --manifest-path src-tauri/Cargo.toml",
    "check:queue-contracts:update": "node scripts/update-queue-contracts.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "review:plan:new": "node scripts/review.mjs plan:new",
    "review:findings:new": "node scripts/review.mjs findings:new",
    "review:plan": "node scripts/review.mjs plan",
    "review:status": "node scripts/review.mjs status",
    "review:lane": "node scripts/review.mjs lane",
    "review:gate": "node scripts/review.mjs gate",
    "review:selftest": "node scripts/review.mjs selftest",
    "review:finalize": "node scripts/review.mjs finalize",
    "vq:snapshot:rebuild": "node scripts/vq-results/build-quality-snapshot.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "bench:queue": "vitest run --config tools/perf/vitest.perf.config.ts",
    "bench:queue:browser": "node tools/perf/queue-large-list.browser.perf.mjs",
    "bench:queue:browser:gate": "node tools/perf/queue-large-list.browser.perf.mjs --assert --jobs 1000 --processing-jobs 2 --paused-jobs 0 --tick-ms 100 --duration-ms 8000 --modes detail,compact,mini --sort-primary progress --sort-primary-direction desc --progress-style bar && node tools/perf/queue-large-list.browser.perf.mjs --assert --jobs 1000 --processing-jobs 2 --paused-jobs 0 --tick-ms 100 --duration-ms 8000 --modes detail,compact,mini --sort-primary elapsed --sort-primary-direction desc --progress-style bar && node tools/perf/queue-large-list.browser.perf.mjs --assert --jobs 1000 --processing-jobs 2 --paused-jobs 0 --tick-ms 100 --duration-ms 8000 --modes detail,compact,mini --sort-primary addedTime --progress-style bar && node tools/perf/queue-large-list.browser.perf.mjs --assert --jobs 1000 --processing-jobs 2 --paused-jobs 0 --tick-ms 100 --duration-ms 8000 --modes detail,compact,mini --sort-primary progress --sort-primary-direction desc --progress-style ripple-card && node tools/perf/queue-large-list.browser.perf.mjs --assert --jobs 1000 --processing-jobs 2 --paused-jobs 0 --tick-ms 100 --duration-ms 8000 --modes detail,compact,mini --sort-primary progress --sort-primary-direction desc --progress-style card-fill && node tools/perf/queue-large-list.browser.perf.mjs --assert --jobs 1000 --processing-jobs 0 --paused-jobs 1000 --tick-ms 0 --duration-ms 8000 --modes detail,compact,mini --sort-primary addedTime --progress-style bar && node tools/perf/queue-large-list.browser.perf.mjs --assert --jobs 1000 --processing-jobs 0 --paused-jobs 1000 --tick-ms 0 --duration-ms 8000 --modes icon-small,icon-medium --progress-style bar && node tools/perf/queue-large-list.browser.perf.mjs --assert --jobs 1000 --processing-jobs 0 --paused-jobs 1000 --tick-ms 0 --duration-ms 6000 --modes detail,icon-small --sort-primary addedTime --progress-style bar --preview-mode missing-auto-ensure --ensure-preview-delay-ms 30",
    "bench:queue:browser:scale": "node tools/perf/queue-large-list.browser.perf.mjs --jobs-list 1000,10000,100000 --processing-jobs 2 --paused-jobs 0 --tick-ms 100 --duration-ms 8000 --modes detail --sort-primary addedTime --progress-style bar --no-assert",
    "bench:queue:browser:scale:gate": "node tools/perf/queue-large-list.browser.perf.mjs --assert --jobs-list 1000,10000,100000 --processing-jobs 2 --paused-jobs 0 --tick-ms 100 --duration-ms 8000 --modes detail --sort-primary addedTime --progress-style bar",
    "bench:queue:browser:long:gate": "node tools/perf/queue-large-list.browser.perf.mjs --assert --jobs 1000 --processing-jobs 2 --paused-jobs 0 --tick-ms 100 --duration-ms 60000 --segments 6 --modes detail,icon-small --sort-primary addedTime --progress-style bar --preview-mode missing-auto-ensure --ensure-preview-delay-ms 30 --max-heap-growth-mb 30",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "audit": "pnpm audit --registry=https://registry.npmjs.org",
    "audit:json": "pnpm audit --json --registry=https://registry.npmjs.org",
    "dup:frontend": "jscpd -c .jscpd.frontend.json src",
    "dup:rust": "jscpd -c .jscpd.backend.json src-tauri/src",
    "dup:all": "jscpd -c .jscpd.frontend.json src && jscpd -c .jscpd.backend.json src-tauri/src",
    "lint": "eslint --max-warnings 0 --cache --cache-strategy content --cache-location .cache/eslint/.eslintcache .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "format:check:frontend": "prettier --check .",
    "format:staged": "lint-staged --no-stash",
    "format:rust:staged": "node scripts/format-rust-staged.mjs",
    "docs:screenshots": "node tools/docs-screenshots/capture.mjs",
    "docs:screenshots:queue-large": "node tools/docs-screenshots/capture-queue-large-list-scroll-verification.mjs --jobs 2000 --processing-jobs 2",
    "docs:screenshots:preview-fallback": "node tools/docs-screenshots/capture-preview-fallback-layout-verification.mjs",
    "tauri": "node scripts/tauri-cli.mjs",
    "tauri:dev": "tauri dev",
    "build:exe": "tauri build --no-bundle",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "highlight.js": "11.12.0",
    "lucide-vue-next": "^0.562.0",
    "reka-ui": "^2.10.5",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "virtua": "^0.48.8",
    "vue": "^3.5.43",
    "vue-echarts": "^8.3.1",
    "vue-i18n": "^11.4.12",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fission-ai/openspec": "^1.13.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "^25.9.8",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jscpd": "^4.3.0",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "stylus": "^0.64.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,vue,cjs,mjs,json,css,scss,md,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
